# /etc/multibot/updater.env — права 600, владелец root
REPO=OWNER/REPO
# Приватный репозиторий: fine-grained token, доступ только к этому репозиторию,
# Repository permissions → Contents: Read-only. Для публичного — оставить пустым.
GITHUB_TOKEN=
# IP, на который Telegram шлёт webhook (ip_address в setWebhook). Пусто — не трогать webhook.
WEBHOOK_IP=
# Куда бот пишет об успешных и неудачных обновлениях (ваш chat_id). Пусто — не писать.
NOTIFY_CHAT_ID=
